{
  "name": "@hermeticor/sdk-react-native",
  "version": "0.4.5",
  "description": "Hermetica React Native SDK: events, push, in-app messages, geofences",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermeticacomms/hermetica-react-native.git"
  },
  "homepage": "https://github.com/hermeticacomms/hermetica-react-native#readme",
  "keywords": [
    "hermeticor",
    "hermetica",
    "email",
    "sms",
    "outreach"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hermeticor/sdk-browser": "^0.4.5"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
